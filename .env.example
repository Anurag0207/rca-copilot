# .env.example — NL-to-Data Insight Platform
#
# Copy this file to .env and fill in real values before running the stack.
# NEVER commit .env to version control.
#
#   cp .env.example .env

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development    # development | staging | production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key:
#   openssl rand -hex 32
SECRET_KEY=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# JWT expiry in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
POSTGRES_DB=nl_insight

# ── Redis ─────────────────────────────────────────────────────────────────────
# Override the default Redis URL if using an external Redis instance
# REDIS_URL=redis://localhost:6379/0

# ── Ollama (local LLM — single model for all tasks, CPU-compatible) ────────────
# URL of the Ollama container (resolved via Docker DNS in docker-compose)
OLLAMA_BASE_URL=http://ollama:11434

# Single model for intent parsing, HQL/SQL generation, and Mermaid diagram generation
# Pull with: docker exec nl_insight_ollama ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# Timeout for Ollama API calls (local CPU inference is slower than cloud)
OLLAMA_TIMEOUT_SECONDS=60.0

# ── MCP Connector ─────────────────────────────────────────────────────────────
# Supported values: mongodb | hive
MCP_CONNECTOR_TYPE=mongodb

# Default connection ID used when no connection_id is specified
MCP_DEFAULT_CONNECTION_ID=default

# ── MongoDB Connector (used when MCP_CONNECTOR_TYPE=mongodb) ──────────────────
# Local dev (outside Docker): mongodb://localhost:27017
# Inside Docker stack:        mongodb://mongodb:27017
# With auth:                  mongodb://user:pass@host:27017
# Fallback URI/database used only for MCP_DEFAULT_CONNECTION_ID when that id
# is not found in MONGO_CONNECTIONS below.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecommerce_db

# Named connections selectable per chat session (CreateSessionRequest.connection_id).
# Both entries below point at the same local Mongo instance, different databases —
# load each dataset with mongoimport (see STARTUP_GUIDE.md Appendix A).
# Must be valid JSON on a single line.
MONGO_CONNECTIONS={"olist":{"uri":"mongodb://localhost:27017","database":"ecommerce_db"},"retail_wh":{"uri":"mongodb://localhost:27017","database":"retail_warehouse_db"}}

# ── Hive Connector (used when MCP_CONNECTOR_TYPE=hive) ────────────────────────
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=default
# PLAIN | KERBEROS | LDAP
HIVE_AUTH_MECHANISM=PLAIN
HIVE_USERNAME=
HIVE_PASSWORD=

# ── Session & Cache ───────────────────────────────────────────────────────────
# Sliding TTL for Redis session keys (seconds)
SESSION_TTL_SECONDS=86400

# Fixed TTL for schema cache (seconds)
SCHEMA_CACHE_TTL_SECONDS=300

# ── Query Execution ───────────────────────────────────────────────────────────
# Hard timeout for MCP query execution (seconds)
QUERY_TIMEOUT_SECONDS=25

# ── Output Files ──────────────────────────────────────────────────────────────
# Absolute path for ephemeral output files inside the backend container
OUTPUT_TEMP_DIR=/tmp/nl_insight_outputs

# How long output files live before cleanup (seconds)
OUTPUT_FILE_TTL_SECONDS=3600

# ── RCA Copilot ───────────────────────────────────────────────────────────────
# Enabled evidence sources, as single-line JSON. "type" is one of:
# elasticsearch | mongodb | hive. "options" are per-connector overrides; any
# connector also accepts "timeout_seconds". Example with all three:
# RCA_CONNECTORS=[{"name":"app-logs","type":"elasticsearch"},{"name":"deploys","type":"mongodb","options":{"database":"rca_demo","collection":"deploy_events"}},{"name":"metrics","type":"hive","options":{"database":"rca_demo","table":"service_metrics"}}]
RCA_CONNECTORS=[{"name":"app-logs","type":"elasticsearch"},{"name":"deploys","type":"mongodb","options":{"database":"rca_demo","collection":"deploy_events"}}]

# Per-connector budget (LLM query planning + fetch). A source exceeding it is
# reported as failed and the analysis continues with the rest.
RCA_CONNECTOR_TIMEOUT_SECONDS=60

# Minutes of history before the incident start used as the z-score baseline
RCA_BASELINE_MINUTES=60

# Error-rate / metric z-score at or above which a bucket counts as anomalous
RCA_ZSCORE_THRESHOLD=3.0

# Row cap per source per analysis
RCA_MAX_RECORDS_PER_SOURCE=2000

# ── Elasticsearch connector ───────────────────────────────────────────────────
# Outside Docker: http://localhost:9200   Inside the compose stack: http://elasticsearch:9200
ES_URL=http://localhost:9200
ES_INDEX=app-logs-*
# Leave empty for the security-disabled demo node. Use ES_API_KEY OR username/password.
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_VERIFY_CERTS=true
